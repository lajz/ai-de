# Local Postgres (see docker-compose.yml). Must have the `vector` + `pg_trgm` extensions.
# The bootstrap connection needs superuser / rds_superuser to create extensions and roles.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fde_dev

# --- apps/api ------------------------------------------------------------------
# WorkOS SSO + Directory Sync. All optional in dev/test: with no WORKOS_API_KEY
# the API binds an in-memory fake and never calls WorkOS. Required when
# NODE_ENV=production.
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_WEBHOOK_SECRET=
# WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# WorkOS org id -> tenant id, JSON. Until tenant provisioning owns this mapping.
# WORKOS_ORG_TENANT_MAP={"org_01HXXXXXXXXXXXXXXXXXXXXXXX":"<tenant-uuid>"}
# FDE_FAKE_KMS=true   # dev/test only — use the in-memory KeyProvider (no AWS)

# --- Authorization (@fde/authz — SpiceDB) -------------------------------------
# Tests + local dev use the in-memory AuthzClient and need none of these; only a
# real deployment does (and NODE_ENV=production requires SPICEDB_ENDPOINT +
# SPICEDB_TOKEN — the in-memory client is refused there). Run SpiceDB locally:
#   docker run --rm -p 50051:50051 authzed/spicedb serve \
#     --grpc-preshared-key dev --grpc-no-tls
#   then: pnpm --filter @fde/authz schema:push
# SPICEDB_ENDPOINT=localhost:50051   # or <tenant>.grpc.authzed.com:443 (Authzed Cloud)
# SPICEDB_TOKEN=dev
# SPICEDB_INSECURE=true              # local --grpc-no-tls only; omit for TLS
# AUTHZ_ENFORCE=false                # true → platform-role checks layered on top of RLS

# --- AI PR review (tools/review) -------------------------------------------------
# Without a key the pre-push AI review is skipped (deterministic checks still run).
# Get one at https://platform.deepseek.com. Other defaults live in .fde-review.json.
REVIEW_API_KEY=
# REVIEW_BASE_URL=https://api.deepseek.com   # or http://localhost:11434/v1 for Ollama
# REVIEW_MODEL=deepseek-v4-flash             # or deepseek-v4-pro, qwen3-coder:30b, claude
#
# github sink only (pnpm review -- --sink github): a fine-grained PAT with
# "Pull requests: read/write" so the bot can resolve review threads. Without it
# the sink uses your ambient gh login (or GITHUB_TOKEN in CI, which can't resolve).
# REVIEW_BOT_TOKEN=

# --- Meeting capture (apps/workers — Recall.ai) --------------------------------
# Without a key, @fde/workers uses the deterministic FakeRecallClient (fine for
# local dev + tests; the CaptureSession workflow runs end to end). The live
# HttpRecallClient + the recall-client smoke test activate when this is set.
# RECALL_API_KEY=
# RECALL_API_BASE_URL=https://us-west-2.recall.ai   # region host; key is region-bound

# --- @fde/llm -----------------------------------------------------------------
# Unit tests mock the SDK/fetch and need none of these. They're only read when
# something makes a real API call (the router, VoyageEmbeddingClient, or the
# skipIf'd live tests). @fde/llm also loads this repo-root .env itself.
#
# Production provider (LLM_PROVIDER unset or `anthropic`): Claude with Zero Data
# Retention. The SDK picks ANTHROPIC_API_KEY up from the environment.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=                        # set to run against Bedrock / a ZDR proxy
#
# Embeddings — VoyageEmbeddingClient (voyage-3.5). Also gates the live embedding test.
VOYAGE_API_KEY=
#
# Dev / CI only: point the router at any OpenAI-style /chat/completions endpoint
# (DeepSeek, Ollama). NO Zero Data Retention guarantee — never regulated content.
# LLM_API_KEY also gates packages/llm/src/live.smoke.test.ts.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.deepseek.com      # or http://localhost:11434/v1 for Ollama
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash               # `default` tier (and `bulk`, absent LLM_BULK_MODEL)
# LLM_BULK_MODEL=

# --- Redacted LLM tracing (@fde/llm — Langfuse) -------------------------------
# Tracing is OPTIONAL. With neither key set, @fde/llm uses NoopTracer and records
# nothing; with both, LangfuseTracer emits REDACTED traces only — token counts,
# prompt version, latency, cost, extraction_run_id, chunk count, coarse outcome,
# and SHA-256 hashes. Never a prompt, a transcript, a model response, or a
# fact/evidence body (`docs/architecture.md`: "Langfuse — redacted traces only").
# Self-host Langfuse in-VPC (LANGFUSE_BASE_URL) so even the redacted metadata
# stays inside the data plane; a Langfuse outage never fails extraction.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://langfuse.internal.example   # self-hosted, in-VPC

# --- Extraction eval harness (@fde/eval) --------------------------------------
# `pnpm --filter @fde/eval eval` scores the committed fixtures against a live
# provider and gates prompt changes on no-regression. It reuses the provider env
# above (LLM_API_KEY for the dev provider, or ANTHROPIC_API_KEY) and prints a
# skip notice with neither. It is NOT part of `pnpm test`.
