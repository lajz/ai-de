  "info": {
    "title": "FDE Context Platform API",
    "description": "HTTP seam — WorkOS auth + request-scoped tenant/engagement context.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "the opaque session token from /auth/callback"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["active", "disabled"]
          }
        },
        "required": ["userId", "tenantId", "email", "name", "status"]
      },
      "EngagementResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "endCustomerName": {
            "type": "string"
          },
          "regionPin": {
            "type": "string",
            "enum": ["us", "eu"]
          },
          "retentionPolicy": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "closed", "shredded"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "endCustomerName", "regionPin", "retentionPolicy", "status", "createdAt"]
      },
      "AuditRowResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "engagementId": {
            "type": "string",
            "nullable": true
          },
          "actorType": {
            "type": "string"
          },
          "actorId": {
            "type": "string",
            "nullable": true
          },
          "action": {
            "type": "string"
          },
          "resourceType": {
            "type": "string",
            "nullable": true
          },
          "resourceId": {
            "type": "string",
            "nullable": true
          },
          "authzDecision": {
            "type": "object",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "engagementId",
          "actorType",
          "actorId",
          "action",
          "resourceType",
          "resourceId",
          "authzDecision",
          "reason",
          "createdAt"
        ]
      },
      "AuditPageResponse": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditRowResponse"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "pass back as ?cursor for the next page"
          }
        },
        "required": ["rows"]
      },
      "EvidenceCitationResponse": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "permalink": {
            "type": "string",
            "nullable": true
          },
          "quote": {
            "type": "string",
            "nullable": true,
            "description": "decrypted supporting quote"
          },
          "charStart": {
            "type": "number",
            "nullable": true
          },
          "charEnd": {
            "type": "number",
            "nullable": true
          },
          "relation": {
            "type": "string",
            "enum": ["supports", "contradicts"]
          }
        },
        "required": ["sourceId", "permalink", "quote", "charStart", "charEnd", "relation"]
      },
      "FactResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["decision", "commitment", "risk", "question", "action_item", "status_change"]
          },
          "summary": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "nullable": true,
            "description": "decrypted detail"
          },
          "status": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceCitationResponse"
            }
          }
        },
        "required": [
          "id",
          "type",
          "summary",
          "body",
          "status",
          "confidence",
          "occurredAt",
          "createdAt",
          "citations"
        ]
      },
      "QaCitationResponse": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "permalink": {
            "type": "string",
            "nullable": true
          },
          "quote": {
            "type": "string"
          }
        },
        "required": ["sourceId", "permalink", "quote"]
      },
      "QaResponse": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QaCitationResponse"
            }
          }
        },
        "required": ["answer", "citations"]
      },
      "AddMemberResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": ["ok"]
      },
      "CallbackResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": ["userId", "tenantId", "email"]
      },
      "ConnectorSyncResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true,
            "enum": ["idle", "running", "error"]
          },
          "lastRunAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cursorPresent": {
            "type": "boolean"
          }
        },
        "required": ["status", "lastRunAt", "cursorPresent"]
      },
      "ConnectorResponse": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "authKind": {
            "type": "string",
            "enum": ["nango-oauth", "bearer", "mcp-oauth", "inbound-push"]
          },
          "enabled": {
            "type": "boolean"
          },
          "effectiveRetention": {
            "type": "string",
            "enum": ["reference-only", "derived-ephemeral-raw", "full-retention"]
          },
          "hasCredential": {
            "type": "boolean",
            "description": "a credential is stored — never the secret itself"
          },
          "sync": {
            "$ref": "#/components/schemas/ConnectorSyncResponse"
          }
        },
        "required": [
          "connector",
          "authKind",
          "enabled",
          "effectiveRetention",
          "hasCredential",
          "sync"
        ]
      },
      "SyncStartedResponse": {
        "type": "object",
        "properties": {
          "workflowId": {
            "type": "string"
          }
        },
        "required": ["workflowId"]
      },
      "ProvenanceFactResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "nullable": true,
            "description": "decrypted detail"
          },
          "status": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "type",
          "summary",
          "body",
          "status",
          "confidence",
          "occurredAt",
          "createdAt"
        ]
      },
      "ProvenanceSourceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "connector": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "urlPermalink": {
            "type": "string",
            "nullable": true
          },
          "workspaceRef": {
            "type": "string",
            "nullable": true,
            "description": "e.g. a Slack/Nango workspace id"
          },
          "containerRef": {
            "type": "string",
            "nullable": true,
            "description": "e.g. a channel/doc/meeting id"
          },
          "authorRef": {
            "type": "string",
            "nullable": true,
            "description": "the artifact's author/speaker ref"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "connector",
          "externalId",
          "kind",
          "urlPermalink",
          "workspaceRef",
          "containerRef",
          "authorRef",
          "occurredAt"
        ]
      },
      "AclSummaryResponse": {
        "type": "object",
        "properties": {
          "ruleCount": {
            "type": "number"
          },
          "principalKinds": {
            "description": "distinct rule scopes (e.g. slack_channel)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ttlSeconds": {
            "type": "number",
            "nullable": true
          }
        },
        "required": ["ruleCount", "principalKinds", "capturedAt", "ttlSeconds"]
      },
      "ProvenanceEvidenceResponse": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "nullable": true,
            "description": "decrypted supporting quote"
          },
          "charStart": {
            "type": "number",
            "nullable": true
          },
          "charEnd": {
            "type": "number",
            "nullable": true
          },
          "relation": {
            "type": "string",
            "enum": ["supports", "contradicts"]
          },
          "source": {
            "$ref": "#/components/schemas/ProvenanceSourceResponse"
          },
          "acl": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AclSummaryResponse"
              }
            ]
          }
        },
        "required": ["quote", "charStart", "charEnd", "relation", "source", "acl"]
      },
      "ExtractionRunResponse": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "promptVersion": {
            "type": "string"
          },
          "costUsd": {
            "type": "number",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["model", "promptVersion", "costUsd", "createdAt"]
      },
      "FactProvenanceResponse": {
        "type": "object",
        "properties": {
          "fact": {
            "$ref": "#/components/schemas/ProvenanceFactResponse"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProvenanceEvidenceResponse"
            }
          },
          "extractionRun": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExtractionRunResponse"
              }
            ]
          }
        },
        "required": ["fact", "evidence", "extractionRun"]
      },
      "EntityProvenanceEntityResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": ["id", "type", "displayName"]
      },
      "EntityDerivationCounterpartResponse": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["entity", "fact"]
          },
          "id": {
            "type": "string"
          }
        },
        "required": ["kind", "id"]
      },
      "EntityDerivationResponse": {
        "type": "object",
        "properties": {
          "relationshipId": {
            "type": "string"
          },
          "predicate": {
            "type": "string",
            "enum": [
              "owns",
              "accountable_for",
              "informed_of",
              "implemented_by",
              "blocks",
              "supersedes",
              "relates_to",
              "member_of",
              "stakeholder_in"
            ]
          },
          "direction": {
            "type": "string",
            "enum": ["outgoing", "incoming"]
          },
          "counterpart": {
            "$ref": "#/components/schemas/EntityDerivationCounterpartResponse"
          },
          "source": {
            "$ref": "#/components/schemas/ProvenanceSourceResponse"
          }
        },
        "required": ["relationshipId", "predicate", "direction", "counterpart", "source"]
      },
      "EntityProvenanceFactResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": ["id", "type", "summary"]
      },
      "EntityProvenanceResponse": {
        "type": "object",
        "properties": {
          "entity": {
            "$ref": "#/components/schemas/EntityProvenanceEntityResponse"
          },
          "derivedFrom": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityDerivationResponse"
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityProvenanceFactResponse"
            }
          }
        },
        "required": ["entity", "derivedFrom", "facts"]
      },
      "GraphNodeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["entity", "fact"]
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "entity displayName or fact summary"
          },
          "status": {
            "type": "string"
          },
          "externalRefs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": ["id", "kind", "type", "label"]
      },
      "GraphEdgeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fromKind": {
            "type": "string",
            "enum": ["entity", "fact"]
          },
          "fromId": {
            "type": "string"
          },
          "predicate": {
            "type": "string"
          },
          "toKind": {
            "type": "string",
            "enum": ["entity", "fact"]
          },
          "toId": {
            "type": "string"
          },
          "sourceId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["id", "fromKind", "fromId", "predicate", "toKind", "toId", "sourceId"]
      },
      "EngagementGraphResponse": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphNodeResponse"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphEdgeResponse"
            }
          },
          "truncated": {
            "type": "boolean",
            "description": "true when the edge cap was hit"
          }
        },
        "required": ["nodes", "edges", "truncated"]
      },
      "SyncStateResponse": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "lastRunAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cursorPresent": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["connector", "status", "lastRunAt", "cursorPresent", "updatedAt"]
      },
      "PipelineRunResponse": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "promptVersion": {
            "type": "string"
          },
          "costUsd": {
            "type": "number",
            "nullable": true
          },
          "inputSourceCount": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["model", "promptVersion", "costUsd", "inputSourceCount", "createdAt"]
      },
      "PipelineRollupsResponse": {
        "type": "object",
        "properties": {
          "totalFacts": {
            "type": "number"
          },
          "totalEmbeddings": {
            "type": "number"
          },
          "totalCostUsd": {
            "type": "number"
          },
          "sourcesByConnector": {
            "type": "object",
            "description": "source count keyed by connector"
          }
        },
        "required": ["totalFacts", "totalEmbeddings", "totalCostUsd", "sourcesByConnector"]
      },
      "PipelineStatusResponse": {
        "type": "object",
        "properties": {
          "syncStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncStateResponse"
            }
          },
          "recentExtractionRuns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PipelineRunResponse"
            }
          },
          "rollups": {
            "$ref": "#/components/schemas/PipelineRollupsResponse"
          }
        },
        "required": ["syncStates", "recentExtractionRuns", "rollups"]
      }
    }
  }
}
