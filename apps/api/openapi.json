  "info": {
    "title": "FDE Context Platform API",
    "description": "HTTP seam — WorkOS auth + request-scoped tenant/engagement context.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "the opaque session token from /auth/callback"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["active", "disabled"]
          }
        },
        "required": ["userId", "tenantId", "email", "name", "status"]
      },
      "EngagementResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "endCustomerName": {
            "type": "string"
          },
          "regionPin": {
            "type": "string",
            "enum": ["us", "eu"]
          },
          "retentionPolicy": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "closed", "shredded"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "endCustomerName", "regionPin", "retentionPolicy", "status", "createdAt"]
      },
      "AuditRowResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "engagementId": {
            "type": "string",
            "nullable": true
          },
          "actorType": {
            "type": "string"
          },
          "actorId": {
            "type": "string",
            "nullable": true
          },
          "action": {
            "type": "string"
          },
          "resourceType": {
            "type": "string",
            "nullable": true
          },
          "resourceId": {
            "type": "string",
            "nullable": true
          },
          "authzDecision": {
            "type": "object",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "engagementId",
          "actorType",
          "actorId",
          "action",
          "resourceType",
          "resourceId",
          "authzDecision",
          "reason",
          "createdAt"
        ]
      },
      "AuditPageResponse": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditRowResponse"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "pass back as ?cursor for the next page"
          }
        },
        "required": ["rows"]
      },
      "EvidenceCitationResponse": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "permalink": {
            "type": "string",
            "nullable": true
          },
          "quote": {
            "type": "string",
            "nullable": true,
            "description": "decrypted supporting quote"
          },
          "charStart": {
            "type": "number",
            "nullable": true
          },
          "charEnd": {
            "type": "number",
            "nullable": true
          },
          "relation": {
            "type": "string",
            "enum": ["supports", "contradicts"]
          }
        },
        "required": ["sourceId", "permalink", "quote", "charStart", "charEnd", "relation"]
      },
      "FactResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["decision", "commitment", "risk", "question", "action_item", "status_change"]
          },
          "summary": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "nullable": true,
            "description": "decrypted detail"
          },
          "status": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceCitationResponse"
            }
          }
        },
        "required": [
          "id",
          "type",
          "summary",
          "body",
          "status",
          "confidence",
          "occurredAt",
          "createdAt",
          "citations"
        ]
      },
      "QaCitationResponse": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "permalink": {
            "type": "string",
            "nullable": true
          },
          "quote": {
            "type": "string"
          }
        },
        "required": ["sourceId", "permalink", "quote"]
      },
      "QaResponse": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QaCitationResponse"
            }
          }
        },
        "required": ["answer", "citations"]
      },
      "AddMemberResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": ["ok"]
      },
      "CallbackResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": ["userId", "tenantId", "email"]
      }
    }
  }
}
