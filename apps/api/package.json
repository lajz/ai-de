    "@fde/core": "workspace:*",
    "@fde/crypto": "workspace:*",
    "@fde/db": "workspace:*",
    "@fde/identity": "workspace:*",
    "@fde/llm": "workspace:*",
    "@fde/mcp": "workspace:*",
    "@fde/request-context": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@temporalio/client": "catalog:",
