{
  "name": "fde-context-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "review": "pnpm --filter @fde/review start",
    "db:bootstrap": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @fde/db run db:bootstrap'",
    "db:harden": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; pnpm --filter @fde/db run db:harden'",
    "db:generate": "pnpm --filter @fde/db run db:generate",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "catalog:",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "^8.19.1",
    "vitest": "catalog:"
  }
}
