{
  "name": "@fde/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "pnpm --filter=@fde/eval... run build && tsx --env-file-if-exists=../../.env src/run.ts",
    "eval:update-baseline": "pnpm run eval -- --update-baseline",
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fde/core": "workspace:*",
    "@fde/llm": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
