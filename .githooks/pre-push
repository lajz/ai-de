#!/usr/bin/env bash
#
# Pre-push gate for a solo project (see tools/review/README.md).
#   1. Deterministic checks — lint / typecheck / format / test. These BLOCK the push.
#   2. Advisory AI review — prints findings, never blocks. SKIPPED when the branch
#      already has an open PR, because .github/workflows/review.yml runs it there
#      (and posts to the PR) — no point paying for it twice.
#
# Escape hatches:
#   git push --no-verify        skip this hook entirely
#   SKIP_REVIEW_GATE=1 git push  skip step 1
#   SKIP_AI_REVIEW=1 git push     skip step 2
#   AI_REVIEW_ALWAYS=1 git push   run step 2 even when a PR is open
set -euo pipefail

# If every pushed ref is a deletion, there is nothing to check.
only_deletions=true
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    only_deletions=false
  fi
done
if [ "$only_deletions" = true ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm not found — skipping checks. Install pnpm to enable the gate." >&2
  exit 0
fi

if [ "${SKIP_REVIEW_GATE:-}" = "1" ]; then
  echo "pre-push: SKIP_REVIEW_GATE=1 — skipping deterministic checks" >&2
else
  echo "pre-push: lint / typecheck / format:check / test"
  pnpm lint
  pnpm typecheck
  pnpm format:check
  pnpm test
fi

branch_has_open_pr() {
  command -v gh >/dev/null 2>&1 &&
    [ "$(gh pr view --json state --jq .state 2>/dev/null)" = "OPEN" ]
}

if [ "${SKIP_AI_REVIEW:-}" = "1" ]; then
  :
elif [ "${AI_REVIEW_ALWAYS:-}" != "1" ] && branch_has_open_pr; then
  echo "pre-push: open PR for this branch — AI review runs in GitHub Actions, skipping the local pass"
else
  echo "pre-push: AI review (advisory)"
  pnpm review || true
fi

exit 0
